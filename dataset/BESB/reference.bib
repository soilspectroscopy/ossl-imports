
@article{dematte_brazilian_2019,
	title = {The {Brazilian} {Soil} {Spectral} {Library} ({BSSL}): {A} general view, application and challenges},
	volume = {354},
	issn = {00167061},
	shorttitle = {The {Brazilian} {Soil} {Spectral} {Library} ({BSSL})},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S0016706118318548},
	doi = {10.1016/j.geoderma.2019.05.043},
	abstract = {The present study was developed in a joint partnership with the Brazilian pedometrics community to standardize and evaluate spectra within the 350–2500 nm range of Brazilian soils. The Brazilian Soil Spectral Library (BSSL) began in 1995, creating a protocol to gather soil samples from different locations in Brazil. The BSSL reached 39,284 soil samples from 65 contributors representing 41 institutions from all 26 states. Through the BSSL spectra database, it was possible to estimate important soil attributes, such as clay, sand, soil organic carbon, cation exchange capacity, pH and base saturation, resulting in differences among the multi-scale models taking Brazil (overall), regional and state scale. In general, spectral descriptive and quantitative behavior indicated important relationship with physical, chemical and mineralogical properties. Statistical analyses showed that six basic patterns of spectral signatures represent the Brazilian soils types and that environmental conditions explain the differences in spectra. This study demonstrates that spectroscopy analyses along with the establishment of soil spectral libraries are a powerful technique for providing information on a national and regional levels. We also developed an interactive online platform showing soil sample locations and their contributors. As soil spectroscopy is considered a fast, simple, accurate and nondestructive analytical procedure, its application may be integrated with wet analysis as an alternative to support the sustainable management of soils.},
	language = {en},
	urldate = {2026-02-03},
	journal = {Geoderma},
	author = {Demattê, José A.M. and Dotto, André Carnieletto and Paiva, Ariane F.S. and Sato, Marcus V. and Dalmolin, Ricardo S.D. and De Araújo, Maria Do Socorro B. and Da Silva, Elisângela B. and Nanni, Marcos R. and Ten Caten, Alexandre and Noronha, Norberto C. and Lacerda, Marilusa P.C. and De Araújo Filho, José Coelho and Rizzo, Rodnei and Bellinaso, Henrique and Francelino, Márcio R. and Schaefer, Carlos E.G.R. and Vicente, Luiz E. and Dos Santos, Uemeson J. and De Sá Barretto Sampaio, Everardo V. and Menezes, Rômulo S.C. and De Souza, José João L.L. and Abrahão, Walter A.P. and Coelho, Ricardo M. and Grego, Célia R. and Lani, João L. and Fernandes, Antonio R. and Gonçalves, Deyvison A.M. and Silva, Sérgio H.G. and De Menezes, Michele D. and Curi, Nilton and Couto, Eduardo G. and Dos Anjos, Lúcia H.C. and Ceddia, Marcos B. and Pinheiro, Érika F.M. and Grunwald, Sabine and Vasques, Gustavo M. and Marques Júnior, José and Da Silva, Airon J. and Barreto, Marcos C. De Vasconcelos and Nóbrega, Gabriel N. and Da Silva, Marcelo Z. and De Souza, Sara F. and Valladares, Gustavo S. and Viana, João Herbert M. and Da Silva Terra, Fabricio and Horák-Terra, Ingrid and Fiorio, Peterson R. and Da Silva, Rafael C. and Frade Júnior, Elizio F. and Lima, Raimundo H.C. and Alba, José M. Filippini and De Souza Junior, Valdomiro S. and Brefin, Maria De Lourdes Mendonça Santos and Ruivo, Maria De Lourdes P. and Ferreira, Tiago O. and Brait, Marny A. and Caetano, Norton R. and Bringhenti, Idone and De Sousa Mendes, Wanderson and Safanelli, José L. and Guimarães, Clécia C.B. and Poppiel, Raul R. and E Souza, Arnaldo Barros and Quesada, Carlos A. and Do Couto, Hilton T. Zarate},
	month = nov,
	year = {2019},
	pages = {113793},
	file = {PDF:/Users/rzhi/Zotero/storage/2ABX9TFA/Demattê et al. - 2019 - The Brazilian Soil Spectral Library (BSSL) A general view, application and challenges.pdf:application/pdf},
}

@article{dematte_brazilian_2022,
	title = {The {Brazilian} {Soil} {Spectral} {Service} ({BraSpecS}): {A} {User}-{Friendly} {System} for {Global} {Soil} {Spectra} {Communication}},
	volume = {14},
	issn = {2072-4292},
	shorttitle = {The {Brazilian} {Soil} {Spectral} {Service} ({BraSpecS})},
	url = {https://www.mdpi.com/2072-4292/14/3/740},
	doi = {10.3390/rs14030740},
	abstract = {Although many Soil Spectral Libraries (SSLs) have been created globally, these libraries still have not been operationalized for end-users. To address this limitation, this study created an online Brazilian Soil Spectral Service (BraSpecS). The system was based on the Brazilian Soil Spectral Library (BSSL) with samples collected in the Visible–Near–Short-wave infrared (vis–NIR–SWIR) and Midinfrared (MIR) ranges. The interactive platform allows users to ﬁnd spectra, act as custodians of the data, and estimate several soil properties and classiﬁcation. The system was tested by 500 Brazilian and 65 international users. Users accessed the platform (besbbr.com.br), uploaded their spectra, and received soil organic carbon (SOC) and clay content prediction results via email. The BraSpecS prediction provided good results for Brazilian data, but performed variably for other countries.},
	language = {en},
	number = {3},
	urldate = {2026-02-06},
	journal = {Remote Sensing},
	author = {Demattê, José A. M. and Paiva, Ariane Francine Da Silveira and Poppiel, Raul Roberto and Rosin, Nícolas Augusto and Ruiz, Luis Fernando Chimelo and Mello, Fellipe Alcantara De Oliveira and Minasny, Budiman and Grunwald, Sabine and Ge, Yufeng and Ben Dor, Eyal and Gholizadeh, Asa and Gomez, Cecile and Chabrillat, Sabine and Francos, Nicolas and Ayoubi, Shamsollah and Fiantis, Dian and Biney, James Kobina Mensah and Wang, Changkun and Belal, Abdelaziz and Naimi, Salman and Hafshejani, Najmeh Asgari and Bellinaso, Henrique and Moura-Bueno, Jean Michel and Silvero, Nélida E. Q.},
	month = feb,
	year = {2022},
	pages = {740},
	file = {PDF:/Users/rzhi/Zotero/storage/XLLMSF6H/Demattê et al. - 2022 - The Brazilian Soil Spectral Service (BraSpecS) A User-Friendly System for Global Soil Spectra Commu.pdf:application/pdf},
}
